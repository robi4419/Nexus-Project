/// The same skills as 'Heatmap rows', for the heatmap's columns. A matrix needs two different fields for its two axes.
/// [Heatmap lift] is blank outside the rows the Top N filter keeps, so the columns show the same skills as the rows.
/// Sorted by Order, most asked-for skill first: a matrix can't sort its columns by a measure.
table 'Heatmap columns'
	lineageTag: d89a1707-ea50-46bf-a13a-a4eb3e5f97d3

	column Skill
		dataType: string
		lineageTag: e2a46a74-c661-4e32-9ddd-e468316eb655
		summarizeBy: none
		sourceColumn: [Skill]
		sortByColumn: Order

	/// 1 for the skill asked for in the most jobs, 2 for the next, and so on (all jobs, as in Skill pairs).
	column Order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: adc25dc8-750d-4eb0-b7f6-35f1c9326f69
		summarizeBy: none
		sourceColumn: [Order]

	partition 'Heatmap columns' = calculated
		mode: import
		source =
				VAR Skills = SUMMARIZE ( 'Skill pairs', 'Skill pairs'[skill], 'Skill pairs'[skill_jobs] )
				RETURN
				    SELECTCOLUMNS (
				        Skills,
				        "Skill", 'Skill pairs'[skill],
				        "Order", RANKX ( Skills, 'Skill pairs'[skill_jobs], , DESC, DENSE )
				    )

