model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["DatabricksHost","DatabricksHttpPath","Date","Skill","Location","Industry","Seniority","Job postings","Job skills","Job locations","Job industries","Job types","Job sources","Skill pairs","Weekly skill trend"]

ref table _Measures
ref table Date
ref table Skill
ref table Location
ref table Industry
ref table Seniority
ref table Source
ref table 'Job postings'
ref table 'Job skills'
ref table 'Job locations'
ref table 'Job industries'
ref table 'Job types'
ref table 'Skill pairs'
ref table 'Weekly skill trend'
ref table 'Heatmap rows'
ref table 'Heatmap columns'
ref table 'Job sources'

ref cultureInfo en-US

