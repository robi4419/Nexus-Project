          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read it:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt"
                    }
                  },
                  {
                    "value": " a skill's share is the jobs asking for it divided by all the new jobs that week on Jobicy, Arbeitnow or Himalayas. A job is new in the week it first appears on any of them (Jobicy and Arbeitnow by publish date, Himalayas by the day we first saw it). A repost, or the same job on another board, isn't new while an earlier listing is still up: 8 weeks for Jobicy and Arbeitnow, until it expires for Himalayas.",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The week of 26 October:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt"
                    }
                  },
                  {
                    "value": " since 31 October, Himalayas also keeps jobs with a tech title but no tech category (SAP consultants, IT support). They ask for SAP 2.6 times as often and for JavaScript half as often, so part of SAP's rise and JavaScript's fall that week comes from that change, not from demand.",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              }
            ]
          }
