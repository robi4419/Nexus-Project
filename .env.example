# Copy to .env and fill in. .env is gitignored: never commit it.

# --- Databricks (used by databricks-sdk, dbt's profiles.yml and Airflow tasks) ---
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
# Optional: where raw API files land (/Volumes/<catalog>/<schema>/<volume>/<source>/...)
# DATABRICKS_LANDING_SCHEMA=bronze
# DATABRICKS_LANDING_VOLUME=landing
# Name of the deployed transform Job that Airflow starts; development mode prefixes it, e.g. "[dev <you>] transform_jobs"
DATABRICKS_TRANSFORM_JOB_NAME=

# --- Airflow (used by docker-compose.yaml) ---
AIRFLOW_UID=50000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Any long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=
HIMALAYAS_API_KEY=

# --- Failure emails (Airflow's SMTP connection, see docker-compose.yaml) ---
# A Gmail address and an app password (Google account > Security > 2-Step Verification > App passwords).
SMTP_USER=
SMTP_PASSWORD=
# Where failure emails go
ALERT_EMAIL=